# Server-only development template. Never commit actual credentials.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Supabase Auth only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# MongoDB Atlas application database
MONGODB_URI=mongodb+srv://app-user:replace-me@dev-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vireo_dev

# Cloudflare R2 private buckets
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_SOURCE_BUCKET=vireo-source-videos-dev
R2_CLIPS_BUCKET=vireo-rendered-clips-dev
SMART_REFRAME_ENABLED=false

TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
DEFAULT_MONTHLY_QUOTA_MINUTES=15
